# ============================================================
# Railway Environment Variables — copy to Railway Dashboard
# → Service → Variables → Raw Editor
# ============================================================
# PORT is injected automatically by Railway. Do NOT set it here.

# --------------- Runtime ---------------
NODE_ENV=production

# --------------- Firebase Client (build-time + runtime) ---------------
# These VITE_* vars are embedded into the JS bundle at build time.
# Set them in Railway BEFORE the first deploy so the build step picks them up.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# --------------- Firebase Admin (server-side) ---------------
# Paste the full contents of your Firebase service account JSON as a single line,
# OR base64-encode it first: base64 -w 0 firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# --------------- Session Security ---------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# --------------- CORS ---------------
# Add your Railway public domain here (Railway → Service → Settings → Public URL).
# Multiple origins are comma-separated.
CORS_ORIGINS=https://your-app.up.railway.app

# --------------- Admin Bootstrap ---------------
# Comma-separated list of emails that are auto-granted admin on first login.
ADMIN_EMAILS=admin@yourdomain.com

# Optional: enable direct email+password admin login (no Firebase required).
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD_HASH=<sha256-hex of the password>

# --------------- AI Services (optional) ---------------
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# --------------- Supabase Storage (optional fallback) ---------------
# Only needed if you want Supabase as a secondary file storage backend.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=uploads
