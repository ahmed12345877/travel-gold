# =============================================================================
# RAILWAY ENVIRONMENT VARIABLES
# Copy these into: Railway dashboard → your service → Variables → Raw Editor
#
# Status legend:
#   ✅ VALUE PROVIDED — copy exactly as shown
#   ⚠️  MUST SET     — app will crash or malfunction without this
#   🔧 OPTIONAL      — only needed for specific features
#
# ─────────────────────────────────────────────────────────────────────────────
# UNDERSTANDING FIREBASE VARIABLES
# ─────────────────────────────────────────────────────────────────────────────
# Railway replaces Firebase App Hosting (the server/compute).
# But Firebase still provides 3 services that the app uses:
#
#   1. Firebase Auth   — user login (email/password + Google Sign-In)
#                        → requires VITE_FIREBASE_* keys
#
#   2. Firestore       — your database (users, bookings, offers…)
#                        → requires FIREBASE_SERVICE_ACCOUNT_JSON
#
#   3. Firebase Storage — file/image uploads
#                        → can be REPLACED by Cloudflare R2 (see section below)
#
# To fully stop using Google Storage, fill in the Cloudflare R2 section.
# Firebase Auth + Firestore remain on Google (replacing them is a full rewrite).
# =============================================================================


# --- RUNTIME ----------------------------------------------------------------
NODE_ENV=production

# PORT is injected automatically by Railway. Do NOT set it manually.


# --- FIREBASE CLIENT (build-time Vite variables) ----------------------------
# ✅ All values below are confirmed from your Firebase project.
VITE_FIREBASE_API_KEY=AIzaSyAszyNw2a7_bv02cf0FBXiPXwt3E2-CXdY
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0364375301.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0364375301
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0364375301.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1001729880037
VITE_FIREBASE_APP_ID=1:1001729880037:android:da145ec4fb1c7f7247090c
VITE_FIREBASE_MEASUREMENT_ID=G-5ETHDXPS4L

# ⚠️  Set this to your Railway app URL AFTER the first successful deploy.
# Railway assigns a URL like https://your-app-name.up.railway.app
# Leave blank for the first deploy, then set and redeploy.
VITE_API_URL=


# --- FIREBASE ADMIN (server-side) -------------------------------------------
# ✅ Storage bucket (matches client config — only needed if NOT using R2)
FIREBASE_STORAGE_BUCKET=gen-lang-client-0364375301.firebasestorage.app

# ⚠️  MUST SET — Firebase Admin SDK credentials (for Firestore database + Auth verification).
# Steps:
#   1. Firebase Console → Project Settings → Service Accounts
#   2. Click "Generate New Private Key" → download the JSON file
#   3. Encode it:  base64 -w 0 firebase-service-account.json   (Linux)
#                  base64 -i firebase-service-account.json      (macOS)
#   4. Paste the single-line base64 output as the value.
FIREBASE_SERVICE_ACCOUNT_JSON=


# --- CLOUDFLARE R2 STORAGE (replaces Firebase Storage for image/file uploads) ---
# 🔧 Fill these in to stop using Google Storage for new file uploads.
# The app auto-detects R2 when R2_ACCOUNT_ID and R2_BUCKET_NAME are set.
# Existing files already uploaded to Firebase Storage are NOT migrated automatically.
#
# How to get these values:
#   1. cloudflare.com → R2 → Create bucket (e.g. "travel-gold-uploads")
#   2. R2 → Manage R2 API Tokens → Create Token (Object Read & Write)
#   3. Note the Account ID from the R2 overview page
#   4. Enable "Public access" on the bucket and copy the public URL
#
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=travel-gold-uploads
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
#
# Once these are set you can also add:
# STORAGE_PROVIDER=r2
# (The app infers R2 automatically, but this makes it explicit.)


# --- SESSION & AUTH ---------------------------------------------------------
# ✅ OAuth token issuer for Firebase ID token validation
OAUTH_SERVER_URL=https://securetoken.google.com/gen-lang-client-0364375301

# ✅ Owner open-id for the SDK admin context
OWNER_OPEN_ID=1e7ec060-4294-4c3b-8210-9c532b6930c3

# ⚠️  MUST SET — Secret used to sign session cookies.
# Generate:  openssl rand -hex 32
JWT_SECRET=


# --- ADMIN ACCESS -----------------------------------------------------------
# ⚠️  MUST SET — Comma-separated Firebase Auth email addresses that are
# automatically granted the "admin" role on their first login.
# Example: ADMIN_EMAILS=you@gmail.com,colleague@gmail.com
ADMIN_EMAILS=

# 🔧 OPTIONAL — Enable direct email+password admin login (no Firebase popup).
# ADMIN_EMAIL=admin@yourapp.com
# ADMIN_PASSWORD_HASH=<sha256 hex of password>
#   Generate: echo -n 'your-password' | sha256sum | cut -d' ' -f1


# --- CORS (only needed for separate frontend domains) -----------------------
# 🔧 OPTIONAL — The app serves frontend + backend from one Railway service,
# so same-origin requests work without this.
# CORS_ORIGINS=https://your-custom-domain.com


# --- AI FEATURES (only if AI routes are used) -------------------------------
# 🔧 OPTIONAL
# OPENAI_API_KEY=
# GEMINI_API_KEY=
