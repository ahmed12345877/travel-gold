{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/.well-known/openid-configuration", "destination": "/api/oidc/openid-configuration" },
    { "source": "/.well-known/jwks.json", "destination": "/api/oidc/jwks" },
    { "source": "/oauth/authorize", "destination": "/api/oidc/oauth/authorize" },
    { "source": "/oauth/token", "destination": "/api/oidc/oauth/token" },
    { "source": "/manus-storage/:path*", "destination": "/api/manus-storage/:path*" },
    { "source": "/api/trpc/:path*", "destination": "/api/trpc/:path*" },
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
